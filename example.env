# Copy this file to .env and fill in real values. See backend/app/config.py for the schema these
# are read into (isik.common.config) - any variable without a documented default is required.

# Required. Signs and encrypts the session cookie - generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional - defaults shown.

# Public self-registration via /api/auth/register. Off by default: turn it on to create your
# account, then off again rather than leaving open signup running.
# REGISTRATION_ENABLED=False

# Where the SQLite database lives. The Docker image sets /app/data/acta.sqlite3 and declares
# /app/data a volume. The generated VAPID key pair (vapid.json) is kept in the same directory.
# DATABASE_PATH=./data/acta.sqlite3

# Keep True behind HTTPS. Set False only for plain http:// (including http://localhost), or the
# browser silently refuses to store the session cookie.
# SESSION_COOKIE_SECURE=True

# Only needed when the frontend is served from another origin than the API.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# Web Push. Leave both keys empty to have a pair generated on first start and kept beside the
# database - set them only to pin a specific pair (every existing subscription is tied to it).
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:acta@localhost

# How often due cards are checked for reminders. 0 turns reminders off.
# REMINDER_INTERVAL_SECONDS=60
